prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "git push は手動で実行してください。Codex による自動 push を禁止します。",
    match = [
        "git push",
        "git push origin main",
        "git push -u origin feature/foo",
        "git push --force",
    ],
    not_match = [
        "git pull",
        "git status",
        "git commit -m 'test'",
    ],
)
